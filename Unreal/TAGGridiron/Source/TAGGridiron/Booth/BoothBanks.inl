// every table (a new section's table goes here)
const std::vector<const std::vector<BkBank>*>& bkTables() {
  static const std::vector<const std::vector<BkBank>*> t = {&bkShow(), &bkResult(), &bkFlags(), &bkKicks(), &bkAnalysis(), &bkPresnap(), &bkStory()};
  return t;
}

const std::unordered_map<std::string, const std::vector<const char*>*>& bkIndex() {
  static const std::unordered_map<std::string, const std::vector<const char*>*> m = [] {
    std::unordered_map<std::string, const std::vector<const char*>*> o;
    for (const std::vector<BkBank>* t : bkTables())
      for (const BkBank& b : *t) o.emplace(b.id, &b.w);  // (a second table with the same id is a mistake: bankDuplicates names it)
    return o;
  }();
  return m;
}

}  // namespace

const std::vector<const char*>& bankWordings(const std::string& bank) {
  static const std::vector<const char*> kNone;
  const auto& m = bkIndex();
  auto it = m.find(bank);
  return it == m.end() ? kNone : *it->second;
}

bool fillWording(const char* wording, const Slots& slots, std::string& out) {
  out.clear();
  for (const char* p = wording; *p; ++p) {
    if (*p != '{') {
      out += *p;
      continue;
    }
    const char* e = std::strchr(p, '}');
    if (!e) return false;
    std::string key(p + 1, e);
    const bool cap = !key.empty() && std::isupper(static_cast<unsigned char>(key[0]));
    if (cap) key[0] = static_cast<char>(std::tolower(static_cast<unsigned char>(key[0])));
    const Slot* f = nullptr;
    for (const Slot& x : slots)
      if (key == x.k) {
        f = &x;
        break;
      }
    if (!f || f->v.empty()) return false;
    std::string v = f->v;
    if (cap) v[0] = static_cast<char>(std::toupper(static_cast<unsigned char>(v[0])));
    out += v;
    p = e;
  }
  return true;
}

std::vector<std::pair<std::string, size_t>> bankSizes() {
  std::vector<std::pair<std::string, size_t>> v;
  for (const auto& kv : bkIndex()) v.push_back({kv.first, kv.second->size()});
  return v;
}

std::vector<std::string> bankDuplicates() {
  std::vector<std::string> d;
  std::unordered_map<std::string, int> n;
  for (const std::vector<BkBank>* t : bkTables())
    for (const BkBank& b : *t)
      if (++n[b.id] == 2) d.push_back(b.id);
  return d;
}

